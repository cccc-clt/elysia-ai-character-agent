# LLM
API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Optional task models (empty = use MODEL_NAME)
CHAT_MODEL_NAME=
EVAL_MODEL_NAME=
SUMMARY_MODEL_NAME=

# Generation
TEMPERATURE=0.9
MAX_TOKENS=1500
MEMORY_SUMMARIZE_INTERVAL=6

# Lore RAG (experimental; safe defaults keep runtime disabled)
LORE_RAG_ENABLED=false
LORE_RAG_PROTOTYPE_MODE=true
LORE_RAG_ALLOW_UNVERIFIED_TRANSCRIPTS=false
LORE_RAG_REQUIRE_CITATIONS=true
LORE_RAG_TOP_K=5
LORE_RAG_MAX_CONTEXT_CHARS=6000
LORE_RAG_BACKEND=hybrid
LORE_RAG_INDEX_PATH=data/lore_index/hashed_vectors.json
LORE_RAG_TIMEOUT_SECONDS=2.0

# Storage
STORAGE_BACKEND=sqlite
DATABASE_PATH=data/elysia_companion.db

# =========================
# Voice
# =========================
ENABLE_VOICE=true

# STT Provider: local_whisper / openai / baidu
STT_PROVIDER=local_whisper

# Local Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# OpenAI-compatible Audio API
AUDIO_API_KEY=
AUDIO_BASE_URL=https://api.openai.com/v1
WHISPER_API_MODEL=whisper-1

# Baidu Speech
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# TTS Provider: edge / openai / gpt_sovits / custom / official_clips
TTS_PROVIDER=gpt_sovits
TTS_FALLBACK_PROVIDER=edge

# Edge TTS
VOICE_NAME=zh-CN-XiaoxiaoNeural

# OpenAI-compatible TTS
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# GPT-SoVITS
GPT_SOVITS_URL=http://localhost:9872
GPT_SOVITS_REF_AUDIO=assets/audio/ref/elysia_ref.wav
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_SPEED=1.0

# Custom local TTS endpoint
CUSTOM_TTS_ENDPOINT=http://localhost:5000/tts

# Audio cache
AUDIO_CACHE_DIR=data/audio_cache

# Local official clips
ENABLE_OFFICIAL_CLIPS=true
OFFICIAL_CLIPS_DIR=assets/audio/official_lines

# Assets
PORTRAIT_PATH=assets/images/elysia_portrait.png
BACKGROUND_PATH=assets/images/elysia_background.png
AVATAR_PATH=assets/images/avatar.png
