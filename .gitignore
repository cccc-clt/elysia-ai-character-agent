.env
.venv/
venv/
__pycache__/
*.py[cod]
.streamlit/secrets.toml
.DS_Store
*.log

# SQLite & runtime data
data/*.db
data/*.sqlite
data/audio_cache/

# Local-only large assets (placeholders documented in assets/README.md)
assets/images/*.png
