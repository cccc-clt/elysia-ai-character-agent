# Voice reference & official clips (keep .gitkeep and official_clips.json)
assets/audio/ref/*
!assets/audio/ref/.gitkeep
assets/audio/official_lines/*.wav
assets/audio/official_lines/*.mp3
assets/audio/official_lines/*.m4a
!assets/audio/official_lines/.gitkeep
!assets/audio/official_lines/official_clips.json
